# Copy to .env.local for local development. Never commit real secrets.

# HS256 session signing key. Required in production — the app throws if unset there.
# Generate one with: openssl rand -hex 32
SESSION_SECRET=dev-session-secret-change-me

# SQLite database file (created on first run, directory is created if missing).
DATABASE_PATH=./data/pintaback.db

# Seed catalog imported by `npm run setup` / `npm run import:csv`.
# SEED_CATALOG_FILE=data/seed/products.csv

# Order-notification email.
# EMAIL_PROVIDER: "resend" to actually send, or leave empty to record in-app only.
EMAIL_PROVIDER=
RESEND_API_KEY=
RESEND_FROM=Pintaback Orders <orders@example.com>
